# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Credenciales locales (nunca deben commitearse) — usadas por set-cors.js y
# por la integración ARCA de functions/, que las espera en el filesystem
# local/del servidor, no en el repo.
serviceAccountKey*.json
*-firebase-adminsdk-*.json
functions/certificados/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
